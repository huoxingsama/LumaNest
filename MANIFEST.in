include README.md LICENSE.md THIRD_PARTY_NOTICES.md SECURITY.md
include CONTRIBUTING.md CHANGELOG.md requirements-windows.lock .gitignore
recursive-include .github *.yml
recursive-include docs *.md *.png
recursive-include scripts *.ps1
